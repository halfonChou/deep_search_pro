# ============ LLM ============
LLM_MODEL=qwen-max
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=your-api-key-here
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# ============ MySQL（业务数据源，只读）============
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=pharma_db
MYSQL_POOL_MIN=1
MYSQL_POOL_MAX=5

# ============ Tavily 搜索 ============
TAVILY_API_KEY=your-tavily-key-here

# ============ RAG / 向量检索 ============
EMBED_MODEL=text-embedding-v3
CHROMA_DIR=data/chroma
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120

# ============ 运行期 ============
DATA_DIR=data
CHECKPOINT_DB=data/checkpoints.sqlite
MAX_CONCURRENT_TASKS=5
EVENT_QUEUE_MAXSIZE=1000

# ============ 安全 ============
 CORS_ORIGINS=["http://localhost:3000"]
 API_TOKEN=
 SQL_TABLE_ALLOWLIST=[]
 SQL_ROW_LIMIT=100
+
+# ============ 调用限制（Day 8）============
+MODEL_CALL_RUN_LIMIT=30
+MODEL_CALL_THREAD_LIMIT=100
+TOOL_CALL_RUN_LIMIT=40
+TOOL_CALL_THREAD_LIMIT=150
+SEARCH_TOOL_RUN_LIMIT=5
+
+# ============ 预算熔断（Day 8）============
+BUDGET_MAX_TOKENS=200000
+BUDGET_MAX_COST_USD=1.0
+PRICE_PER_1M_INPUT=0.5
+PRICE_PER_1M_OUTPUT=2.0
+
+# ============ 重试与降级（Day 8）============
+TOOL_RETRY_MAX=3
+TOOL_RETRY_INITIAL_DELAY=1.0
+TOOL_RETRY_BACKOFF=2.0
+FALLBACK_MODELS=[]